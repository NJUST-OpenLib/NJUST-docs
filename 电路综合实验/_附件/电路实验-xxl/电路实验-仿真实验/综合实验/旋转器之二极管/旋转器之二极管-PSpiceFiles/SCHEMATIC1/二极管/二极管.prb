[DISPLAYS]
BEGIN DISPLAY LAST SESSION
ANALYSIS DC_SWEEP
SYMBOL ALWAYS
TRACECOLORSCHEME NORMAL
BEGIN ANAPLOT 1
ACTIVE
XBASE
BEGIN XAXIS
XAXISUSERNAME 0 (null)
TEXT V_V
RANGEFLAG AUTO
TYPE LINEAR
UNIT V
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
END XAXIS
BEGIN YAXIS 1
YAXISSIDE LEFT
ACTIVE
RANGEFLAG AUTO
TYPE LINEAR
UNIT x
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
BEGIN TRACE V(V6:+,V6:-)
MARKERID 1
TRACEADDEXT
END TRACE V(V6:+,V6:-)
BEGIN TRACE V(U4:A,0)
MARKERID 3
TRACEADDEXT
END TRACE V(U4:A,0)
BEGIN TRACE -I(R7)
MARKERID 5
TRACEADDEXT
END TRACE -I(R7)
BEGIN TRACE -I(R6)
MARKERID 6
TRACEADDEXT
END TRACE -I(R6)
END YAXIS 1
END ANAPLOT 1
END DISPLAY LAST SESSION
