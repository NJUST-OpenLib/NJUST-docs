[DISPLAYS]
BEGIN DISPLAY LAST SESSION
ANALYSIS TRANSIENT_ANALYSIS
SYMBOL ALWAYS
TRACECOLORSCHEME NORMAL
BEGIN ANAPLOT 1
ACTIVE
XBASE
BEGIN XAXIS
XAXISUSERNAME 0 User Defined Title
TEXT V(V6:+)
RANGEFLAG MANUAL
TYPE LINEAR
UNIT V
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
REFMIN -8
REFMAX 8
REFUNIT V
END XAXIS
BEGIN YAXIS 1
YAXISSIDE LEFT
ACTIVE
RANGEFLAG MANUAL
TYPE LINEAR
UNIT A
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
REFMIN -0.008
REFMAX 0.008
REFUNIT A
BEGIN TRACE I(R6)
MARKERID 0
END TRACE I(R6)
BEGIN TRACE I(R9)
MARKERID 28
END TRACE I(R9)
BEGIN TRACE V(V6:+,V6:-)
MARKERID 2
TRACEADDEXT
END TRACE V(V6:+,V6:-)
BEGIN TRACE V(R7:2,0)
MARKERID 4
TRACEADDEXT
END TRACE V(R7:2,0)
BEGIN TRACE -I(R9)
MARKERID 7
TRACEADDEXT
END TRACE -I(R9)
BEGIN TRACE I(R6)
MARKERID 27
TRACEADDEXT
END TRACE I(R6)
BEGIN TRACE V(V6:+,V6:-)
MARKERID 1
TRACEADDEXT
END TRACE V(V6:+,V6:-)
END YAXIS 1
END ANAPLOT 1
END DISPLAY LAST SESSION
